# Copy this file to .env.dev for development: cp .env.example .env.dev
# Dev values are dummy values. Do not put real secrets in this file.

# Settings on the dashboard. Most of the values below are only the FIRST values.
# A superuser can change them on the dashboard (Ops > Settings). A value saved there wins over
# this file and takes effect in a few seconds, with no restart. The Telegram bot token is saved
# encrypted. The schedule, the news feeds, and the market instruments are in the database too.
# This file keeps the values that the dashboard cannot hold: the secret key, the database,
# Redis, the host names, and the security flags.
# Key that encrypts the secrets saved on the dashboard. If you leave it empty, DJANGO_SECRET_KEY is
# used. Set it to a separate random value if you may rotate DJANGO_SECRET_KEY. If this key
# changes, the saved secrets cannot be read. Enter them again on the dashboard.
# SETTINGS_ENCRYPTION_KEY=
# Login lockout (django-axes). These are the first values. Change them on Ops > Settings.
# LOGIN_FAILURE_LIMIT=5      # Failed logins from one address before the lockout.
# LOGIN_COOLOFF_MINUTES=30   # 0 means: locked until an admin unlocks it on Ops > Logins.
# More first values for things that were in the code before.
# TELEGRAM_API_URL=https://api.telegram.org
# SCREENER_BASE_URL=https://www.screener.in
# MARKET_CLOSE_TIME=15:30
# MARKET_FINAL_BUFFER_MINUTES=10
# NEWS_STALE_AFTER_HOURS=7
# Subscriptions (Ops > Settings > Subscription). Off by default: nobody is locked out.
# SUBSCRIPTIONS_REQUIRED=false
# SUBSCRIPTION_TRIAL_DAYS=7
# SUBSCRIPTION_PERIOD_DAYS=30
# SUBSCRIPTION_PRICE=0
# SUBSCRIPTION_CURRENCY=INR
# SUBSCRIPTION_NOTICE_DAYS=3
# SUBSCRIPTION_CONTACT_TEXT=Ask the admin to turn on your subscription.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. The host "db" is the Compose service name.
# For commands outside Docker, use localhost instead of db.
POSTGRES_DB=kash
POSTGRES_USER=kash
POSTGRES_PASSWORD=kash
DATABASE_URL=postgres://kash:kash@db:5432/kash

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Local LLM (Ollama). Use a small model in dev.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b

# News collection. These are the defaults. You can leave them as they are.
# NEWS_USER_AGENT=Mozilla/5.0 (compatible; KashEngineBot/0.1; +https://github.com/ananthunalloor/kashengine)
# NEWS_SCRAPE_FULL_TEXT=true
# NEWS_SCRAPE_DELAY_SECONDS=3
# NEWS_SCRAPE_BATCH_SIZE=50
# NEWS_SCRAPE_MAX_AGE_HOURS=48

# Sentiment scoring (local LLM). These are the defaults.
# LLM_TIMEOUT_SECONDS=180
# SENTIMENT_MAX_CHARS=2000
# SENTIMENT_BATCH_SIZE=50
# SENTIMENT_MAX_AGE_HOURS=48
# SENTIMENT_MAX_ATTEMPTS=3

# Market prediction. These are the defaults. They are a first guess, not fitted to data.
# Change them only when `python manage.py prediction_stats` gives a reason.
# MARKET_FLAT_BAND_PCT=0.25
# PREDICTION_NEWS_WEIGHT=0.5
# PREDICTION_THRESHOLD=0.15
# PREDICTION_MIN_ARTICLES=5

# IPOs. The fetch is OFF by default. Read the note at the top of apps/ipos/sources.py first.
# IPO_FETCH_ENABLED=false
# IPO_SOURCE_URLS=https://webnodejs.chittorgarh.com/cloud/report/data-read/82/1/{month}/{year}/{fy}/0/all/0?search=&v=1
# GMP and subscription from a live table. OFF by default. Read apps/ipos/gmp.py first.
# IPO_GMP_ENABLED=false
# IPO_GMP_URL=https://www.investorgain.com/report/ipo-gmp-live/331/
# Listing price from Yahoo Finance (first day open), for IPOs that listed lately.
# IPO_LISTING_ENABLED=true
# IPO_LISTING_CHECK_DAYS=14
# IPO_KEEP_DAYS=60
# IPO_METRIC_MAX_AGE_HOURS=72
# IPO_NEWS_DAYS=14
# IPO_GOOD_SCORE=0.3
# IPO_WEAK_SCORE=0.1
# IPO_GOOD_GAIN_PCT=10

# Company data from Screener.in. OFF by default.
# Their terms allow "personal, non-commercial transitory viewing". Read the note at the top of
# apps/companies/screener.py before you set this to true.
# SCREENER_ENABLED=false
# SCREENER_DELAY_SECONDS=5
# SCREENER_REFRESH_DAYS=7
# SCREENER_BATCH_SIZE=100

# Telegram. Use a separate test bot in dev. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# The report time and all other times are on the dashboard (Ops > Schedule).

# Chat IDs that get the report, separated by commas. Send a message to your bot, then run:
#   docker compose exec web python manage.py telegram_check
TELEGRAM_CHAT_IDS=
# TELEGRAM_TIMEOUT_SECONDS=20
# REPORT_NEWS_ITEMS=3
# REPORT_NEWS_MIN_RELEVANCE=0.4
# REPORT_IPO_ITEMS=6
# REPORT_IPO_DAYS_AHEAD=7

# The web pages. Make the login with: python manage.py createsuperuser
# The Datastar script. The default is the CDN (jsDelivr). To serve it from this site, save the
# file as static/vendor/datastar.js and use /static/vendor/datastar.js here.
# DATASTAR_SRC=https://cdn.jsdelivr.net/gh/starfederation/datastar@v1.0.4/bundles/datastar.js
# WEB_PAGE_SIZE=25
