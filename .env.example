# Copy this file to .env.dev for development: cp .env.example .env.dev
# Dev values are dummy values. Do not put real secrets in this file.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. The host "db" is the Compose service name.
# For commands outside Docker, use localhost instead of db.
POSTGRES_DB=kash
POSTGRES_USER=kash
POSTGRES_PASSWORD=kash
DATABASE_URL=postgres://kash:kash@db:5432/kash

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Local LLM (Ollama). Use a small model in dev.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b

# News collection. These are the defaults. You can leave them as they are.
# NEWS_USER_AGENT=Mozilla/5.0 (compatible; KashEngineBot/0.1; +https://github.com/ananthunalloor/kashengine)
# NEWS_FETCH_EVERY_HOURS=3
# NEWS_SCRAPE_FULL_TEXT=true
# NEWS_SCRAPE_DELAY_SECONDS=3
# NEWS_SCRAPE_BATCH_SIZE=50
# NEWS_SCRAPE_MAX_AGE_HOURS=48

# Sentiment scoring (local LLM). These are the defaults.
# LLM_TIMEOUT_SECONDS=180
# SENTIMENT_MAX_CHARS=2000
# SENTIMENT_BATCH_SIZE=50
# SENTIMENT_MAX_AGE_HOURS=48
# SENTIMENT_MAX_ATTEMPTS=3

# Market prediction. These are the defaults. They are a first guess, not fitted to data.
# Change them only when `python manage.py prediction_stats` gives a reason.
# MARKET_FLAT_BAND_PCT=0.25
# PREDICTION_NEWS_WEIGHT=0.5
# PREDICTION_THRESHOLD=0.15
# PREDICTION_MIN_ARTICLES=5

# Company data from Screener.in. OFF by default.
# Their terms allow "personal, non-commercial transitory viewing". Read the note at the top of
# apps/companies/screener.py before you set this to true.
# SCREENER_ENABLED=false
# SCREENER_DELAY_SECONDS=5
# SCREENER_REFRESH_DAYS=7
# SCREENER_BATCH_SIZE=100

# Telegram. Use a separate test bot in dev. Get a token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Daily report time (IST)
REPORT_HOUR=7
REPORT_MINUTE=30
