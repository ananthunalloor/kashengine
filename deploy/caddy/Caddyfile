# Caddy is the only service that is open to the internet. It ends TLS and sends the requests to
# the Django app (web:8000) on a private Docker network.
#
# Settings come from the environment (see docker-compose.prod.yml and .env.prod.example):
#   SITE_ADDRESS        Your domain name. A public name gets a Let's Encrypt certificate.
#                       "localhost" or an IP address gets a certificate from Caddy's own CA.
#   OLD_SITE_ADDRESS    Hostname of the archived, superuser-only Django interface.
#   ACME_EMAIL          Where Let's Encrypt sends notices about the certificate.
#   ADMIN_ALLOWED_IPS   Who may open admin, Ops, its private API, and the entire archive.
#   DOCS_ALLOWED_IPS    Who may open /docs/ (the developer docs). The default is everyone.
#   CSP_HEADER          Content-Security-Policy to enforce the policy. Use
#                       Content-Security-Policy-Report-Only to test it without blocking.
{
	# No admin API. This closes a port and a way to change the config at run time.
	admin off
	email {$ACME_EMAIL}

	servers {
		# Close slow clients (slowloris) and idle connections.
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip

	# Django already sends HSTS, X-Content-Type-Options, X-Frame-Options, Referrer-Policy and
	# Cross-Origin-Opener-Policy (see config/settings/prod.py). Caddy adds the headers that
	# Django does not send.
	# The docs site sets its own Content-Security-Policy (docs/nginx.conf). The policy of the
	# docs site needs script hashes that change with each build, so Caddy must not add a second one.
	@docs_path path /docs /docs/*
	header @docs_path {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy same-origin
	}
	@application_path not path /docs /docs/*
	header @application_path {
		{$CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy same-origin
	}

	# Allow bounded snapshots only on the superuser restore endpoint (including form overhead).
	@backup_import path /api/app/ops/actions/backups/import/
	request_body @backup_import {
		max_size 141MiB
	}
	@small_forms not path /api/app/ops/actions/backups/import/
	request_body @small_forms {
		max_size 2MB
	}

	log {
		output stdout
		format json
	}

	# Routing. All "handle" blocks run in the order written here, and the first match wins.
	# Do not put a "respond" or "reverse_proxy" outside a "handle": Caddy runs a "handle" block
	# before them, so a catch-all "handle" would make them dead code.
	#
	# 1. The admin site and the Ops pages are open to ADMIN_ALLOWED_IPS only.
	@admin_denied {
		path /admin /admin/* /ops /ops/* /api/app/ops /api/app/ops/*
		not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	handle @admin_denied {
		respond "Forbidden" 403
	}

	# 2. The developer docs are open to DOCS_ALLOWED_IPS only. The prefix is not stripped:
	# the docs container serves its files under /docs/, the same path as the public URL.
	@docs_denied {
		path /docs /docs/*
		not remote_ip {$DOCS_ALLOWED_IPS:0.0.0.0/0 ::/0}
	}
	handle @docs_denied {
		respond "Forbidden" 403
	}
	handle @docs_path {
		reverse_proxy docs:8080 {
			header_down -Server
		}
	}

	# 3. Everything else is the Django app. Caddy replaces any X-Forwarded-* header from the
	# client, so the app can trust X-Forwarded-Proto (SECURE_PROXY_SSL_HEADER).
	handle {
		reverse_proxy web:8000 {
			header_down -Server
		}
	}
}

# The legacy interface is isolated by hostname and by Django's superuser gate.
{$OLD_SITE_ADDRESS:old.localhost} {
	encode zstd gzip
	header {
		{$CSP_HEADER:Content-Security-Policy} "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net 'unsafe-eval'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Resource-Policy same-origin
	}
	@archive_import path /ops/backups/import/
	request_body @archive_import {
		max_size 141MiB
	}
	@archive_forms not path /ops/backups/import/
	request_body @archive_forms {
		max_size 2MB
	}
	@archive_denied not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
	handle @archive_denied {
		respond "Forbidden" 403
	}
	handle {
		reverse_proxy web:8000 {
			header_down -Server
		}
	}
	log {
		output stdout
		format json
	}
}

# Health check for the Docker healthcheck. It listens inside the container only.
http://:8081 {
	bind 127.0.0.1
	respond /healthz 200
}
