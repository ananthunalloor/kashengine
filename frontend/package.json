{
  "name": "kash-engine-frontend",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b",
    "build:legacy-css": "tailwindcss -i styles/legacy.css -o ../static/css/app.css --minify",
    "watch:legacy-css": "tailwindcss -i styles/legacy.css -o ../static/css/app.css --watch",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "oxfmt src vite.config.ts vitest.config.ts openapi-ts.config.ts",
    "format:check": "oxfmt --check src vite.config.ts vitest.config.ts openapi-ts.config.ts",
    "api:generate": "openapi-ts",
    "api:check": "openapi-ts && git diff --exit-code -- src/shared/api/generated"
  },
  "dependencies": {
    "@mantine/core": "^8.2.0",
    "@mantine/dates": "^8.2.0",
    "@mantine/hooks": "^8.2.0",
    "@tanstack/charts": "^1.1.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-router": "^1.130.17",
    "@tanstack/react-table": "^8.21.3",
    "dayjs": "^1.11.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.130.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "oxfmt": "0.73.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
