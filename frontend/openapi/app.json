{
  "openapi": "3.1.0",
  "info": {
    "title": "Kash Engine App API",
    "version": "0.1.0",
    "description": ""
  },
  "paths": {
    "/api/app/session": {
      "get": {
        "operationId": "get_app_session",
        "summary": "Get the current browser session and visible navigation",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Return the signed-in user's permissions, even when their subscription has ended.\n\nArgs:\n    request: The authenticated browser request.\n\nReturns:\n    Session details and feature-filtered links using the same rules as Django templates.",
        "tags": [
          "Session"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
    "/api/app/reports": {
      "get": {
        "operationId": "list_app_reports",
        "summary": "List daily reports for the browser",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "title": "Page",
              "type": "integer"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Return a bounded page using the existing web page size and date ordering.",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
    "/api/app/reports/{day}": {
      "get": {
        "operationId": "get_app_report",
        "summary": "Read a report and its delivery status",
        "parameters": [
          {
            "in": "path",
            "name": "day",
            "schema": {
              "format": "date",
              "title": "Day",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportDetail"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Preserve saved-data rendering, adjacent dates, and staff-only delivery diagnostics.",
        "tags": [
          "Reports"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
    "/api/app/news": {
      "get": {
        "operationId": "list_app_news",
        "summary": "Search and filter the browser news feed",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "default": "",
              "description": "Headline or summary search text.",
              "maxLength": 100,
              "title": "Q",
              "type": "string"
            },
            "required": false,
            "description": "Headline or summary search text."
          },
          {
            "in": "query",
            "name": "source",
            "schema": {
              "default": "",
              "description": "Exact source name, or all.",
              "maxLength": 100,
              "title": "Source",
              "type": "string"
            },
            "required": false,
            "description": "Exact source name, or all."
          },
          {
            "in": "query",
            "name": "sentiment",
            "schema": {
              "default": "",
              "description": "Sentiment category, or empty for all.",
              "pattern": "^(|positive|negative|neutral|unscored)$",
              "title": "Sentiment",
              "type": "string"
            },
            "required": false,
            "description": "Sentiment category, or empty for all."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Requested page; out-of-range values are clamped.",
              "title": "Page",
              "type": "integer"
            },
            "required": false,
            "description": "Requested page; out-of-range values are clamped."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NewsPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Preserve the existing search, score thresholds, source filters, and display values.",
        "tags": [
          "News"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
    "/api/app/ipos": {
      "get": {
        "operationId": "list_app_ipos",
        "summary": "Search and filter IPOs for the browser",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "default": "",
              "description": "IPO name search text.",
              "maxLength": 100,
              "title": "Q",
              "type": "string"
            },
            "required": false,
            "description": "IPO name search text."
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "default": "",
              "description": "Issue status; empty means Active (not listed).",
              "pattern": "^(|open|upcoming|closed|listed|all)$",
              "title": "Status",
              "type": "string"
            },
            "required": false,
            "description": "Issue status; empty means Active (not listed)."
          },
          {
            "in": "query",
            "name": "verdict",
            "schema": {
              "default": "",
              "description": "Verdict, or all.",
              "pattern": "^(|good|mixed|weak|unknown)$",
              "title": "Verdict",
              "type": "string"
            },
            "required": false,
            "description": "Verdict, or all."
          },
          {
            "in": "query",
            "name": "category",
            "schema": {
              "default": "",
              "description": "Board, or all.",
              "pattern": "^(|mainboard|sme)$",
              "title": "Category",
              "type": "string"
            },
            "required": false,
            "description": "Board, or all."
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "description": "Requested page; out-of-range values are clamped.",
              "title": "Page",
              "type": "integer"
            },
            "required": false,
            "description": "Requested page; out-of-range values are clamped."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpoPage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Preserve Active ordering, listed history, board and verdict filtering.",
        "tags": [
          "IPOs"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    },
    "/api/app/ipos/{pk}": {
      "get": {
        "operationId": "get_app_ipo",
        "summary": "Read an IPO's facts and verdict evidence",
        "parameters": [
          {
            "in": "path",
            "name": "pk",
            "schema": {
              "title": "Pk",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpoDetail"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "description": "Use saved scoring evidence, preserve units and freshness, and never recalculate scores.",
        "tags": [
          "IPOs"
        ],
        "security": [
          {
            "AppSession": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "NavigationItem": {
        "description": "One visible link, calculated using the server's feature and subscription rules.",
        "properties": {
          "label": {
            "description": "Human-readable section name.",
            "title": "Label",
            "type": "string"
          },
          "url": {
            "description": "Same-origin path to the existing section.",
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "label",
          "url"
        ],
        "title": "NavigationItem",
        "type": "object"
      },
      "Session": {
        "description": "The current browser user's permissions and navigation.",
        "properties": {
          "id": {
            "description": "User primary key.",
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "description": "Signed-in user's display name.",
            "title": "Username",
            "type": "string"
          },
          "is_staff": {
            "description": "Whether this user can read Ops pages.",
            "title": "Is Staff",
            "type": "boolean"
          },
          "is_superuser": {
            "description": "Whether this user can perform Ops writes.",
            "title": "Is Superuser",
            "type": "boolean"
          },
          "features": {
            "description": "Feature keys currently available to this user.",
            "items": {
              "type": "string"
            },
            "title": "Features",
            "type": "array"
          },
          "subscription_required": {
            "description": "Whether the site requires a subscription.",
            "title": "Subscription Required",
            "type": "boolean"
          },
          "subscription_ok": {
            "description": "Whether subscription rules permit feature access.",
            "title": "Subscription Ok",
            "type": "boolean"
          },
          "subscription_state": {
            "description": "Current subscription state, or staff exemption.",
            "enum": [
              "trial",
              "active",
              "expired",
              "none",
              "staff"
            ],
            "title": "Subscription State",
            "type": "string"
          },
          "notice": {
            "description": "Subscription warning; empty when there is no warning.",
            "title": "Notice",
            "type": "string"
          },
          "navigation": {
            "description": "Visible links, in menu order.",
            "items": {
              "$ref": "#/components/schemas/NavigationItem"
            },
            "title": "Navigation",
            "type": "array"
          },
          "logout_url": {
            "description": "Same-origin Django logout endpoint; requires CSRF POST.",
            "title": "Logout Url",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "is_staff",
          "is_superuser",
          "features",
          "subscription_required",
          "subscription_ok",
          "subscription_state",
          "notice",
          "navigation",
          "logout_url"
        ],
        "title": "Session",
        "type": "object"
      },
      "FieldError": {
        "description": "One wrong parameter in a `validation_error`.",
        "properties": {
          "field": {
            "description": "The name of the parameter.",
            "title": "Field",
            "type": "string"
          },
          "message": {
            "description": "What is wrong.",
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "A short machine-readable reason, for example `int_parsing`.",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "field",
          "message",
          "type"
        ],
        "title": "FieldError",
        "type": "object"
      },
      "Problem": {
        "description": "An error answer (RFC 9457). The content type is `application/problem+json`.",
        "properties": {
          "type": {
            "description": "A link to the explanation of the code.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "description": "The HTTP status text.",
            "title": "Title",
            "type": "string"
          },
          "status": {
            "description": "The HTTP status code.",
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "description": "What went wrong in this case. Safe to show to a user.",
            "title": "Detail",
            "type": "string"
          },
          "instance": {
            "description": "The path of the request.",
            "title": "Instance",
            "type": "string"
          },
          "code": {
            "description": "A stable code. Branch on this value, not on `detail`.",
            "title": "Code",
            "type": "string"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "The wrong parameters. Only for `validation_error`.",
            "title": "Errors"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "ReportPage": {
        "description": "A page of daily reports in newest-first order.",
        "properties": {
          "items": {
            "description": "Reports on this page.",
            "items": {
              "$ref": "#/components/schemas/ReportSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "description": "Resolved page number, starting at one.",
            "title": "Page",
            "type": "integer"
          },
          "pages": {
            "description": "Total number of pages; one for an empty list.",
            "title": "Pages",
            "type": "integer"
          },
          "total": {
            "description": "Total number of reports.",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "pages",
          "total"
        ],
        "title": "ReportPage",
        "type": "object"
      },
      "ReportSummary": {
        "description": "A report's date and outlook, without the full report text.",
        "properties": {
          "date": {
            "description": "Trading date of the daily report.",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "prediction": {
            "description": "Outlook direction: up, down, flat, or empty if unavailable.",
            "title": "Prediction",
            "type": "string"
          },
          "strength": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Formatted 1.0-10.0 signal strength, not a probability.",
            "title": "Strength"
          }
        },
        "required": [
          "date",
          "prediction",
          "strength"
        ],
        "title": "ReportSummary",
        "type": "object"
      },
      "ReportDelivery": {
        "description": "Delivery status without recipient addresses or member-visible diagnostics.",
        "properties": {
          "id": {
            "description": "Delivery attempt primary key.",
            "title": "Id",
            "type": "integer"
          },
          "channel": {
            "description": "Human-readable delivery channel.",
            "title": "Channel",
            "type": "string"
          },
          "status": {
            "description": "Delivery status key: sent or failed.",
            "title": "Status",
            "type": "string"
          },
          "status_label": {
            "description": "Human-readable delivery status.",
            "title": "Status Label",
            "type": "string"
          },
          "created_at": {
            "description": "Time of the delivery attempt.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure diagnostic for staff only; otherwise null.",
            "title": "Error"
          }
        },
        "required": [
          "id",
          "channel",
          "status",
          "status_label",
          "created_at",
          "error"
        ],
        "title": "ReportDelivery",
        "type": "object"
      },
      "ReportDetail": {
        "description": "The display report and its delivery history.",
        "properties": {
          "date": {
            "description": "Trading date of the daily report.",
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "prediction": {
            "description": "Outlook direction: up, down, flat, or empty if unavailable.",
            "title": "Prediction",
            "type": "string"
          },
          "strength": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Formatted 1.0-10.0 signal strength, not a probability.",
            "title": "Strength"
          },
          "text": {
            "description": "Display text, reformatted from saved data when available.",
            "title": "Text",
            "type": "string"
          },
          "deliveries": {
            "description": "Delivery attempts, newest first.",
            "items": {
              "$ref": "#/components/schemas/ReportDelivery"
            },
            "title": "Deliveries",
            "type": "array"
          },
          "older": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Date of the nearest older report, if any.",
            "title": "Older"
          },
          "newer": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Date of the nearest newer report, if any.",
            "title": "Newer"
          }
        },
        "required": [
          "date",
          "prediction",
          "strength",
          "text",
          "deliveries",
          "older",
          "newer"
        ],
        "title": "ReportDetail",
        "type": "object"
      },
      "NewsFilters": {
        "description": "Bound search input to the same lengths as the existing web filters.",
        "properties": {
          "q": {
            "default": "",
            "description": "Headline or summary search text.",
            "maxLength": 100,
            "title": "Q",
            "type": "string"
          },
          "source": {
            "default": "",
            "description": "Exact source name, or all.",
            "maxLength": 100,
            "title": "Source",
            "type": "string"
          },
          "sentiment": {
            "default": "",
            "description": "Sentiment category, or empty for all.",
            "pattern": "^(|positive|negative|neutral|unscored)$",
            "title": "Sentiment",
            "type": "string"
          },
          "page": {
            "default": 1,
            "description": "Requested page; out-of-range values are clamped.",
            "title": "Page",
            "type": "integer"
          }
        },
        "title": "NewsFilters",
        "type": "object"
      },
      "NewsFilterOption": {
        "description": "One server-supported sentiment filter.",
        "properties": {
          "value": {
            "description": "Filter query value.",
            "title": "Value",
            "type": "string"
          },
          "label": {
            "description": "Human-readable filter name.",
            "title": "Label",
            "type": "string"
          }
        },
        "required": [
          "value",
