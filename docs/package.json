{
  "name": "kashengine-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Developer documentation for Kash Engine",
  "scripts": {
    "reference:generate": "node scripts/run_reference.js",
    "reference:check": "node scripts/run_reference.js --no-write --check",
    "prestart": "npm run reference:generate",
    "start": "docusaurus start --host 0.0.0.0",
    "prebuild": "npm run reference:generate",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 0.0.0.0 --port 8080",
    "typecheck": "node --check docusaurus.config.js && node --check sidebars.js",
    "clear": "docusaurus clear"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=20.0"
  }
}
