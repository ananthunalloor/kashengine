# Copy this file to .env.prod on the server: cp .env.prod.example .env.prod
# Put real values in .env.prod. Never commit .env.prod to Git.

DJANGO_SETTINGS_MODULE=config.settings.prod
# Make a long random key. Example: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Keep "localhost" in the list. The Docker health check needs it.
DJANGO_ALLOWED_HOSTS=your-domain.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_SECURE_SSL_REDIRECT=true

# Database
POSTGRES_DB=kash
POSTGRES_USER=kash
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://kash:change-me@db:5432/kash

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Local LLM (Ollama). Use a larger model in prod. The server needs 16 GB RAM or more.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b

# Telegram. Use the real bot token.
TELEGRAM_BOT_TOKEN=change-me

# Daily report time (IST)
REPORT_HOUR=7
REPORT_MINUTE=30
