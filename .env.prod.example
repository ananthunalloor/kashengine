# Copy this file to .env.prod on the server: cp .env.prod.example .env.prod
# Put real values in .env.prod. Never commit .env.prod to Git.

DJANGO_SETTINGS_MODULE=config.settings.prod
# Make a long random key. Example: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Keep "localhost" in the list. The Docker health check needs it.
DJANGO_ALLOWED_HOSTS=your-domain.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
DJANGO_SECURE_SSL_REDIRECT=true

# Database
POSTGRES_DB=kash
POSTGRES_USER=kash
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://kash:change-me@db:5432/kash

# Redis (Celery broker)
REDIS_URL=redis://redis:6379/0

# Local LLM (Ollama). Use a larger model in prod. The server needs 16 GB RAM or more.
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b

# News collection. These are the defaults. You can leave them as they are.
# Put a contact URL in the User-Agent, so site owners can reach you.
# NEWS_USER_AGENT=Mozilla/5.0 (compatible; KashEngineBot/0.1; +https://your-domain.com)
# NEWS_FETCH_EVERY_HOURS=3
# NEWS_SCRAPE_FULL_TEXT=true
# NEWS_SCRAPE_DELAY_SECONDS=3
# NEWS_SCRAPE_BATCH_SIZE=50
# NEWS_SCRAPE_MAX_AGE_HOURS=48

# Sentiment scoring (local LLM). These are the defaults.
# LLM_TIMEOUT_SECONDS=180
# SENTIMENT_MAX_CHARS=2000
# SENTIMENT_BATCH_SIZE=50
# SENTIMENT_MAX_AGE_HOURS=48
# SENTIMENT_MAX_ATTEMPTS=3

# Market prediction. These are the defaults. They are a first guess, not fitted to data.
# Change them only when `python manage.py prediction_stats` gives a reason.
# MARKET_FLAT_BAND_PCT=0.25
# PREDICTION_NEWS_WEIGHT=0.5
# PREDICTION_THRESHOLD=0.15
# PREDICTION_MIN_ARTICLES=5

# IPOs. The fetch is OFF by default. Read the note at the top of apps/ipos/sources.py first.
# IPO_FETCH_ENABLED=false
# IPO_SOURCE_URLS=https://webnodejs.chittorgarh.com/cloud/report/data-read/82/1/{month}/{year}/{fy}/0/all/0?search=&v=1
# GMP and subscription from a live table. OFF by default. Read apps/ipos/gmp.py first.
# IPO_GMP_ENABLED=false
# IPO_GMP_URL=https://www.investorgain.com/report/ipo-gmp-live/331/
# Listing price from Yahoo Finance (first day open), for IPOs that listed lately.
# IPO_LISTING_ENABLED=true
# IPO_LISTING_CHECK_DAYS=14
# IPO_KEEP_DAYS=60
# IPO_METRIC_MAX_AGE_HOURS=72
# IPO_NEWS_DAYS=14
# IPO_GOOD_SCORE=0.3
# IPO_WEAK_SCORE=0.1
# IPO_GOOD_GAIN_PCT=10

# Company data from Screener.in. OFF by default.
# Their terms allow "personal, non-commercial transitory viewing". Read the note at the top of
# apps/companies/screener.py before you set this to true.
# SCREENER_ENABLED=false
# SCREENER_DELAY_SECONDS=5
# SCREENER_REFRESH_DAYS=7
# SCREENER_BATCH_SIZE=100

# Telegram. Use the real bot token.
TELEGRAM_BOT_TOKEN=change-me

# Daily report time (IST)
REPORT_HOUR=7
REPORT_MINUTE=30

# Chat IDs that get the report, separated by commas. Send a message to your bot, then run:
#   docker compose exec web python manage.py telegram_check
TELEGRAM_CHAT_IDS=
# TELEGRAM_TIMEOUT_SECONDS=20
# REPORT_NEWS_ITEMS=3
# REPORT_NEWS_MIN_RELEVANCE=0.4
# REPORT_IPO_ITEMS=6
# REPORT_IPO_DAYS_AHEAD=7
